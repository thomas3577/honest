{
  "name": "@dx/honest",
  "version": "0.2.0",
  "license": "MIT",
  "nodeModulesDir": "none",
  "exports": {
    ".": "./mod.ts",
    "./testing": "./src/testing.ts"
  },
  "tasks": {
    "demo": "deno run -A ./demo/main.ts",
    "update": "deno outdated --update --latest && npm install"
  },
  "imports": {
    "@needle-di/core": "jsr:@needle-di/core@1.2.1",
    "hono": "jsr:@hono/hono@^4.13.13",
    "@std/log": "jsr:@std/log@0.224.14"
  },
  "publish": {
    "exclude": [
      ".github",
      ".vscode",
      "demo",
      "test",
      ".gitignore",
      ".editorconfig",
      "deno.lock",
      "package.json",
      "package-lock.json",
      ".npmrc",
      "bunfig.toml",
      "**/*.test.ts"
    ]
  },
  "test": {
    "exclude": [
      "test/workers/"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 360,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve",
    "exclude": [
      ".vscode/**"
    ]
  }
}
